# ---- Database ----
POSTGRES_USER=ain
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ain
DATABASE_URL=postgresql+psycopg://ain:change_me@postgres:5432/ain

# ---- Kafka / MQTT / MinIO ----
KAFKA_BOOTSTRAP=kafka:9092
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=bridge
MQTT_PASSWORD=change_me_mqtt
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change_me_minio
MINIO_SECURE=false

# ---- Security ----
JWT_SECRET=generate_a_long_random_string
JWT_EXPIRE_MIN=30

# ---- AI ----
VISION_WEIGHTS=/app/models/vision/weights/best.pt
VISION_MIN_CONF=0.5

# ---- Fusion / Priority (قابلة للتجربة في الـ ablation) ----
FUSION_ENABLED=true
FUSION_RADIUS_M=50
FUSION_WINDOW_MIN=30
FUSION_THRESHOLD=0.5
